# --- Backend Environment Variables (Host on Render / Railway) ---
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
DATA_ENCRYPTION_KEY=replace_with_32_byte_or_longer_encryption_key
# Comma-separated allowed frontend origins (e.g. https://your-medqr-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Persistent volume directory for database.json on Render (/var/data) or Railway (/data)
DATA_DIR=
ENABLE_PUBLIC_TUNNEL=false
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_HOSPITAL_PASSWORD=replace_with_strong_hospital_password
SEED_PATIENT_PASSWORD=replace_with_strong_patient_password

# --- Frontend Environment Variable (Set in Vercel Project Settings) ---
# Point to your hosted backend URL in production (e.g. https://medqr-plus-backend.onrender.com/api)
VITE_API_URL=/api
